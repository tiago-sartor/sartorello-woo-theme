{
    "name": "sartorello-woo-theme",
    "version": "1.0.0",
    "author": "",
    "description": "",
    "keywords": [],
    "license": "ISC",
    "main": "index.js",
    "type": "module",
    "dependencies": {
        "alpinejs": "^3.17.2",
        "@alpinejs/collapse": "^3.17.2",
        "@alpinejs/intersect": "^3.17.2",
        "@alpinejs/resize": "^3.17.2"
    },
    "devDependencies": {
        "tailwindcss": "^4.3.3",
        "@tailwindcss/cli": "^4.3.3",
        "webpack": "^5.110.3",
        "webpack-cli": "^7.2.3"
    },
    "scripts": {
        "dev": "npm run dev:webpack && npm run dev:tailwind",
        "build": "npm run build:tailwind && npm run build:ts && npm run build:webpack",
        "build:ts": "npm run build:ts:frontend && npm run build:ts:admin",
        "build:ts:frontend": "tsc -p tsconfig.frontend.json",
        "build:ts:admin": "tsc -p tsconfig.admin.json",
        "dev:tailwind": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/frontend/css/style.css --watch",
        "build:tailwind": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/frontend/css/style.css",
        "dev:webpack": "webpack --mode development --watch; ",
        "build:webpack": "webpack --mode production",
        "upgrade-dependencies": "npx npm-check-updates -u && npm install"
    }
}